{
  "name": "go2-payroll",
  "private": true,
  "version": "1.0.0",
  "description": "Go2-Payroll - Complete Payroll Management System",
  "author": "Go2-BillingSoftware Team",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.6.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.294.0",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.5",
    "react-calendar": "^4.6.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.go2payroll.desktop",
    "productName": "Go2-Payroll",
    "directories": {
      "output": "build-output"
    },
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "Go2-Payroll-Portable.exe",
      "requestExecutionLevel": "user"
    }
  }
}
